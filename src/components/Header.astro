---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { LOCALES, LOCALE_NAMES, t, type Locale, type Route } from '../i18n';
import { GALLERIES } from '../data/site';
import { photosIn } from '../utils/photos';

interface Props {
  locale: Locale;
  route: Route;
}

const { locale, route } = Astro.props;
const dict = t(locale);

// Раздел без единого кадра в меню не показывается: страница у него есть и
// открывается по прямой ссылке, но вести туда посетителя не за чем. Так новый
// раздел не выходит наружу раньше своих фотографий — он появляется сам, когда
// кадры лягут в src/photos/.
//
// Последний пункт меню — контакты, а не «Обо мне» (F1_P40, решение заказчицы
// 2026-08-21). Из приёмов, между которыми выбирали, взят обмен местами: шапка
// не растёт и не переезжает на третью строку, потому что пунктов по-прежнему
// пять. «Обо мне» не пропало — оно ушло в подвал, где стоит рядом с контактами
// и условиями использования кадров.
const links: { route: Route; label: string }[] = [
  ...GALLERIES.filter((slug) => photosIn(slug).length > 0).map((slug) => ({
    route: slug as Route,
    label: dict.nav[slug],
  })),
  { route: 'contact', label: dict.nav.contact },
];
---

<header class="header">
  <div class="wrap header__inner">
    <a class="header__name" href={getRelativeLocaleUrl(locale, '')}>{dict.name}</a>

    <nav class="nav" aria-label={locale === 'sr' ? 'Glavna navigacija' : 'Main navigation'}>
      {
        links.map((link) => (
          <a
            href={getRelativeLocaleUrl(locale, link.route)}
            aria-current={route === link.route ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="lang">
      {
        LOCALES.map((code, i) => (
          <>
            {i > 0 && <span aria-hidden="true">/</span>}
            <a
              href={getRelativeLocaleUrl(code, route)}
              aria-current={code === locale ? 'true' : undefined}
              hreflang={code}
            >
              {LOCALE_NAMES[code]}
            </a>
          </>
        ))
      }
    </div>
  </div>
</header>
