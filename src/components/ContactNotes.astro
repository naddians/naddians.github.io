---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);

// Строка под кнопками контактов (F1_P63, решение заказчицы 2026-08-19):
// человек пишет, не прочитав ни условий работы, ни условий использования
// кадров, — и разговор начинается с того, что должно было быть прочитано
// до письма. Строка стоит там же, где кнопки: на главной и на «Обо мне»,
// то есть в обеих точках, откуда с сайта пишут.
//
// На самой странице контактов её нет: условия работы там же на странице,
// а на условия кадров ведёт подвал.
//
// Порядок ссылок — решение заказчицы: первым то, ради чего пишут чаще
// (съёмка), лицензирование кадра — реже. Ссылка на условия работы ведёт
// в раздел (`#working-together`, id заведён заранее в F1_P39): человек
// попадает не в начало страницы контактов, где адреса, которые он уже видел,
// а сразу к тому, ради чего шёл.
const links = [
  {
    text: dict.contact.notes.workLink,
    href: `${getRelativeLocaleUrl(locale, 'contact')}#working-together`,
  },
  { text: dict.contact.notes.licenseLink, href: getRelativeLocaleUrl(locale, 'license') },
];
---

{/* Одна строка на две ссылки, а не две фразы (выбор заказчицы из десяти
    раскладок, 2026-08-19): полными фразами блок контактов на телефоне
    вырастал на 106px — почти вдвое, — и адреса уезжали с экрана. Здесь
    прибавка 35px, и оба названия остаются на виду. Стоит под кнопками:
    вариант над ними тоже собрали и сравнили на экране телефона целиком —
    заказчица выбрала этот. */}
<p class="contact-notes">
  {dict.contact.notes.lead}{' '}
  {
    links.map((link, index) => (
      <>
        {/* Точка-разделитель, а не запятая: это перечень названий, а не фраза.
            От читалки она скрыта — вслух две ссылки подряд и так читаются
            раздельно, а «средняя точка» между ними была бы мусором. */}
        {index > 0 && <span class="contact-notes__dot" aria-hidden="true">·</span>}
        <a class="contact-notes__link contact-link" href={link.href}>{link.text}</a>
      </>
    ))
  }
</p>
