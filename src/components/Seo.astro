---
import { getImage } from 'astro:assets';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { HTML_LANG, LOCALES, metaKeyFor, t, type Locale, type Route } from '../i18n';
import { CONTACTS, COVERS } from '../data/site';
import { photoAt } from '../utils/photos';

interface Props {
  locale: Locale;
  route: Route;
}

const { locale, route } = Astro.props;
const dict = t(locale);
const meta = dict.meta[metaKeyFor(route)];

// Превью ссылки: обложка раздела, обрезанная до 1200×630 (ТЗ §10).
// JPEG, а не AVIF: мессенджеры и соцсети до сих пор понимают его надёжнее всех.
const cover = photoAt(COVERS[route] ?? '');
const ogImage = cover
  ? new URL(
      (
        await getImage({
          src: cover,
          width: 1200,
          height: 630,
          fit: 'cover',
          position: 'center',
          format: 'jpeg',
          quality: 80,
        })
      ).src,
      Astro.site,
    ).href
  : undefined;

const canonical = getAbsoluteLocaleUrl(locale, route);
const alternates = LOCALES.map((code) => ({
  code: HTML_LANG[code],
  href: getAbsoluteLocaleUrl(code, route),
}));

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: dict.name,
  jobTitle: locale === 'sr' ? 'Motosport fotografkinja' : 'Motorsport photographer',
  address: { '@type': 'PostalAddress', addressLocality: 'Belgrade', addressCountry: 'RS' },
  url: getAbsoluteLocaleUrl(locale, ''),
  email: `mailto:${CONTACTS.email}`,
  sameAs: [
    `https://instagram.com/${CONTACTS.instagram}`,
    `https://t.me/${CONTACTS.telegram}`,
  ],
  knowsAbout: ['Formula 1', 'Formula 2', 'Motorsport photography'],
};
---

<title>{meta.title}</title>
<meta name="description" content={meta.description} />
<link rel="canonical" href={canonical} />

{/* Портрет на «Обо мне» в Картинки Google не попадает (F1_P60, решение
    заказчицы 2026-08-19). Кадр не её: на нём она сама, снимал кто-то другой,
    поэтому условий использования у него нет и быть не может — а раз брать его
    нельзя, то и показывать в поиске картинок незачем. `noimageindex` относится
    ко всем кадрам страницы, но на «Обо мне» кадр ровно один. Сама страница
    индексируется как прежде: запрет только на картинки. */}
{route === 'about' && <meta name="robots" content="noimageindex" />}

{alternates.map((alt) => <link rel="alternate" hreflang={alt.code} href={alt.href} />)}
<link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl('en', route)} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={dict.name} />
<meta property="og:locale" content={locale === 'sr' ? 'sr_RS' : 'en_GB'} />
<meta property="og:title" content={meta.title} />
<meta property="og:description" content={meta.description} />
<meta property="og:url" content={canonical} />
{
  ogImage && (
    <>
      <meta property="og:image" content={ogImage} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content={meta.title} />
    </>
  )
}
<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

{
  (route === '' || route === 'about') && (
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} is:inline />
  )
}
