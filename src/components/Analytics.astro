---
import { UMAMI_WEBSITE_ID } from '../data/site';
---

{/*
  Счётчик посещений Umami (F1_P51). Без кук — значит без баннера про них.
  Base.astro вставляет этот блок, только когда номер сайта вписан в site.ts.

  - Файл счётчика лежит у нас (`public/umami.js`), а не на их сервере:
    браузеру не нужно знакомиться с чужим доменом, пока грузятся кадры.
  - `defer` — счётчик выполняется после разбора страницы и кадрам не мешает.
  - `data-domains` — считать только живой сайт: локальная сборка и тесты
    в статистику не попадают.
  - `data-exclude-hash` — просмотрщик пишет в адрес `#photo-4` на каждый кадр;
    без этого каждый пролистанный кадр считался бы новой страницей. Кадры
    считаются отдельным событием.
  - `data-performance` — заодно мерить скорость у живых посетителей: когда
    появился главный кадр, прыгала ли вёрстка.
*/}
<script
  is:inline
  defer
  src={`${import.meta.env.BASE_URL}umami.js`}
  data-website-id={UMAMI_WEBSITE_ID}
  data-domains="naddians.photo"
  data-exclude-hash="true"
  data-performance="true"
></script>

<script>
  /**
   * Нажатия на всё, что нажимается (F1_P51, просьба заказчицы — «разметить
   * вообще всё кликабельное»). Один слушатель на всю страницу, а не метка
   * на каждой ссылке. У каждого нажатия своё понятное имя — «Меню»,
   * «Карточка раздела», «Напишите мне», — а не общее «Клик» (заказчица
   * 2026-10-07: «вместо тупо клик разметить нормально, что это такое»).
   * Что не узнано — уходит как «Другое нажатие» со всеми подробностями,
   * чтобы новая кнопка не пропала молча, а была видна и получила своё имя.
   *
   * Метки Umami (`data-umami-event`) здесь не годятся: на ссылке он сначала
   * дожидается ответа своего сервера и только потом пускает по ней, то есть
   * каждый переход по меню тормозил бы на время запроса. Здесь отчёт уходит
   * параллельно, а переход не ждёт — браузер дошлёт его сам (keepalive).
   *
   * Кадры в ленте и кнопки просмотрщика тут не считаются: их считает сам
   * просмотрщик, точнее — какой кадр и как до него дошли (PhotoViewer.astro).
   */
  import { count } from '../utils/count';

  /** Страницы — по-русски и без языка: People на сербском — тоже People. */
  const PAGES: Record<string, string> = {
    '': 'главная',
    track: 'Track',
    people: 'People',
    atmosphere: 'Atmosphere',
    beyond: 'Beyond F1',
    about: 'Обо мне',
    contact: 'Контакты',
    license: 'Условия использования',
    freearchive: 'Открытый архив',
  };

  /** Куда ведёт ссылка: страница сайта словами или чужой сайт. */
  const target = (href: string) => {
    const url = new URL(href);
    if (url.origin !== location.origin) return url.host + url.pathname;
    const slug = url.pathname.replace(/^\/(sr|de)(?=\/|$)/, '').replace(/^\/|\/$/g, '');
    const page = PAGES[slug] ?? url.pathname;
    return url.hash === '#working-together' ? `${page}, условия работы` : page;
  };

  const text = (el: Element | null | undefined) =>
    (el?.getAttribute('aria-label') || el?.textContent || '').replace(/\s+/g, ' ').trim().slice(0, 50);

  document.addEventListener(
    'click',
    (event) => {
      const el = (event.target as Element).closest('a, button, summary');
      if (!el || el.matches('a.shot') || el.closest('dialog')) return;

      const href = el instanceof HTMLAnchorElement ? el.href : '';
      const to = href ? target(href) : '';
      const where = el.closest('header') ? 'шапка' : el.closest('footer') ? 'подвал' : 'страница';

      // Адрес почты в отчёт не идёт — только то, что нажали именно её.
      if (href.startsWith('mailto:')) return count('Контакт', { через: 'почта', где: where });
      // Свой Instagram помечен rel="me" — так ссылка на него отличается
      // от ссылок на тех, с кем работали («Обо мне»).
      if (/instagram\.com/.test(href)) {
        return el.matches('[rel~="me"]')
          ? count('Контакт', { через: 'Instagram', где: where })
          : count('Instagram партнёра', { кто: new URL(href).pathname.replace(/\//g, '') });
      }
      if (el.hasAttribute('hreflang')) return count('Язык', { на: el.getAttribute('hreflang')! });
      // У каждого пункта меню свой счётчик: «Меню: People», «Меню: главная»
      // (заказчица 2026-11-19: «чтобы было понятно, в какой именно пункт»).
      // Одно общее «Меню» прятало пункт в подробностях события.
      if (el.closest('header')) return count(`Меню: ${to}`.slice(0, 50));
      // Ссылка на открытый архив в подвале — свой счётчик, отдельно от
      // остальных ссылок подвала (заказчица 2026-10-12: «нужен уникальный
      // для этой ссылки»). Откуда нажали — какая страница.
      if (el.matches('.footer__archive')) return count('Подвал: открытый архив', { откуда: target(location.href) });
      if (el.closest('footer')) return count('Подвал', { куда: to });
      // Плитка серии — тоже .card, но считается ниже, вместе с серией.
      if (el.matches('.card:not(.card--series)')) return count('Карточка раздела', { раздел: to });
      if (el.matches('.cta__link')) return count('Напишите мне');
      // У каждой съёмки в открытом архиве свой счётчик, как у серий ниже:
      // «Архив: T4 Series Serbia · Round 6». Слово короткое, потому что имя
      // события у Umami — не длиннее 50 знаков, а названия съёмок длинные.
      if (el.matches('.archive__open')) {
        return count(`Архив: ${text(el.closest('.archive__item')?.querySelector('.archive__name'))}`.slice(0, 50));
      }
      // У каждой серии свой счётчик — по её названию, вместе с разделом:
      // «Beyond F1: T4 Series Serbia» (заказчица: «разделим все серии, чтобы
      // понимать, какие более интересны»). Название берётся полное, из
      // заголовка серии: в списке над лентой оно бывает сокращено.
      // Список серий сейчас есть только в Beyond F1, но строится в любой
      // галерее, где серий больше одной.
      // Плитка серии на главной (F1_P97) идёт в тот же счётчик серии, что и
      // список в самом разделе: «Beyond F1: T4 Series Serbia», как — «с главной».
      // Раздел здесь — куда ведёт плитка, а не где нажали.
      const series = el.closest('.series-nav')
        ? 'из списка'
        : el.matches('.series__anchor')
          ? 'скопировали ссылку'
          : el.matches('.card--series')
            ? 'с главной'
            : '';
      if (series) {
        const title = document.querySelector(`${new URL(href).hash} .series__anchor`)?.getAttribute('aria-label') || text(el);
        const page = el.matches('.card--series') ? to : target(location.href);
        return count(`${page}: ${title}`.slice(0, 50), { как: series });
      }
      if (el.matches('summary')) return count('Условия работы: пункт', { пункт: text(el) });
      if (el.matches('.skip')) return count('Пропустить меню');
      if (href) return count('Ссылка в тексте', { куда: to });

      count('Другое нажатие', { что: text(el), куда: to });
    },
    true,
  );

  /**
   * Глубина прокрутки (F1_P102). Заказчица 2026-11-19: многие открывают сайт
   * и никуда не нажимают — а смотрят ли они ленту? Отметки 25, 50, 75 и 100 %
   * страницы, у каждой страницы свои: «Прокрутка: Track, 50 %» (одно общее
   * событие прятало бы страницу в подробностях — как было с «Меню»).
   * Каждая отметка уходит не больше раза за открытие страницы.
   *
   * Считается только прокрутка самого человека: пока он не листал сам
   * (колесо, палец, клавиши прокрутки, полоса прокрутки), прыжки страницы
   * не в счёт. Иначе ссылка на серию Beyond F1 (`#t4`) или пункт списка серий,
   * которые сами уводят вниз, давали бы «50 %» без единого движения.
   * Поэтому нажатие по ссылке или кнопке прокрутку не «включает».
   */
  const STEPS = [25, 50, 75, 100];
  const reached = new Set<number>();
  const page = target(location.href);
  let touched = false;

  const depth = () => {
    if (!touched) return;
    const doc = document.documentElement;
    // Страница целиком на экране — прокручивать нечего, и считать нечего.
    if (doc.scrollHeight <= innerHeight + 1) return;
    // Нижний край экрана относительно всей страницы; 2px — на дробные пиксели,
    // иначе 100 % на телефоне иногда не набиралось бы.
    const share = ((scrollY + innerHeight + 2) / doc.scrollHeight) * 100;
    for (const step of STEPS) {
      if (share >= step && !reached.has(step)) {
        reached.add(step);
        count(`Прокрутка: ${page}, ${step} %`.slice(0, 50));
      }
    }
  };

  const SCROLL_KEYS = ['ArrowDown', 'PageDown', 'End', ' '];
  const touch = () => (touched = true);
  addEventListener('wheel', touch, { passive: true });
  addEventListener('touchmove', touch, { passive: true });
  addEventListener('keydown', (e) => SCROLL_KEYS.includes(e.key) && !(e.target as Element).closest?.('a, button, summary, input, textarea') && touch());
  // Полоса прокрутки: нажатие мимо ссылок и кнопок.
  addEventListener('pointerdown', (e) => !(e.target as Element).closest?.('a, button, summary, dialog') && touch(), { passive: true });
  addEventListener('scroll', depth, { passive: true });
</script>
