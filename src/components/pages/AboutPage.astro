---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ContactButtons from '../ContactButtons.astro';
import ContactNotes from '../ContactNotes.astro';
import { t, type Locale } from '../../i18n';
import { COLLABS, EVENTS, GEAR } from '../../data/site';
import { photoAt } from '../../utils/photos';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);

const portrait =
  photoAt('about/portrait.jpg') ??
  photoAt('about/portrait.jpeg') ??
  photoAt('about/portrait.png') ??
  photoAt('about/portrait_demo.jpg');
---

<Base locale={locale} route={'about'}>
  <div class:list={['wrap', 'about', !portrait && 'about--no-portrait']}>
    {
      portrait && (
        <Picture
          class="about__portrait"
          src={portrait}
          alt={dict.name}
          formats={['avif', 'webp']}
          widths={[320, 640, 900]}
          sizes="(min-width: 900px) 34vw, 100vw"
          loading="eager"
        />
      )
    }

    <div class="about__body">
      <h1>{dict.about.title}</h1>
      <p class="about__base">{dict.about.base}</p>

      {
        dict.about.bio.length > 0 && (
          <div class="about__bio">
            {dict.about.bio.map((paragraph: string) => (
              <p>{paragraph}</p>
            ))}
          </div>
        )
      }

      <section class="block">
        <h2 class="block__title">{dict.about.eventsTitle}</h2>
        <ul class="list">
          {
            EVENTS.map((event) => (
              <li>
                {event.venue} · {event.year}
                <br />
                <span class="list__meta">{event.series.join(' · ')}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="block">
        <h2 class="block__title">{dict.about.gearTitle}</h2>
        <p style="margin:0">{GEAR}</p>
      </section>

      <section class="block">
        <h2 class="block__title">{dict.contact.title}</h2>
        <ContactButtons locale={locale} compact />
        <ContactNotes locale={locale} />
      </section>

      {
        COLLABS.length > 0 && (
          <section class="block">
            <h2 class="block__title">{dict.about.collabsTitle}</h2>
            <ul class="list list--links">
              {COLLABS.map((collab) => (
                <li>
                  <a
                    class="contact-link"
                    href={`https://instagram.com/${collab.handle}`}
                    rel="noopener"
                  >
                    @{collab.handle}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </div>
</Base>
