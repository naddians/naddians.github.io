---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PhotoGrid from '../PhotoGrid.astro';
import { t, type Locale, type Route } from '../../i18n';
import { COVERS, COVER_FOCUS, type GallerySlug } from '../../data/site';
import { groupsIn, photoAt, photosIn } from '../../utils/photos';

interface Props {
  locale: Locale;
  gallery: GallerySlug;
}

const { locale, gallery } = Astro.props;
const dict = t(locale);
const meta = dict.galleries[gallery];
const photos = photosIn(gallery);

// Beyond F1 показывается группами по сериям, остальные разделы — одной лентой:
// там серия одна и та же, называть её нечем и незачем (см. groupsIn).
const groups = groupsIn(gallery);

// Шапка раздела — тот же кадр, что стоит на карточке раздела на главной и
// уходит в превью ссылки (COVERS). Меняется по-прежнему в одном месте:
// src/data/site.ts.
const cover = photoAt(COVERS[gallery] ?? '');

// Шапка тянется во всю ширину окна, поэтому вариантов нужно больше, чем в
// галерее: на широком мониторе и на ретине браузер берёт самый крупный.
// Верхняя ступенька — ширина самого файла (COVER_WIDTH в scripts/photos.mjs).
const HERO_LADDER = [640, 1024, 1600, 2200, 2800];
const heroWidths = cover
  ? [...HERO_LADDER.filter((w) => w < cover.width), cover.width]
  : [];

// Видимая часть кадра — по умолчанию середина, отдельные разделы сдвигаются
// (COVER_FOCUS в src/data/site.ts).
const focus = COVER_FOCUS[gallery];
---

<Base locale={locale} route={gallery as Route}>
  {
    cover ? (
      <section class="hero hero--section">
        <Picture
          src={cover}
          alt=""
          formats={['avif', 'webp']}
          widths={heroWidths}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          pictureAttributes={{ class: 'hero__placeholder' }}
          class="hero__image hero__image--section"
          style={focus ? `object-position: ${focus}` : undefined}
        />
        <div class="hero__scrim" />
        <div class="wrap hero__inner">
          <h1 class="hero__title hero__title--section">{meta.title}</h1>
          <p class="hero__slogan">{meta.description}</p>
        </div>
      </section>
    ) : (
      <div class="wrap page-head">
        <h1>{meta.title}</h1>
        <p>{meta.description}</p>
      </div>
    )
  }

  {
    photos.length === 0 ? (
      <p class="wrap empty">{dict.gallery.empty}</p>
    ) : groups.length > 0 ? (
      <div class="wrap section">
        {groups.map((group, index) => (
          <section class:list={['series', index > 0 && 'series--next']}>
            {group.title && <h2 class="series__title">{group.title}</h2>}
            <PhotoGrid photos={group.photos} />
          </section>
        ))}
      </div>
    ) : (
      <div class="wrap section">
        <PhotoGrid photos={photos} />
      </div>
    )
  }
</Base>
