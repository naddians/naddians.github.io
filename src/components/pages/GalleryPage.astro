---
import Base from '../../layouts/Base.astro';
import PhotoGrid from '../PhotoGrid.astro';
import PhotoViewer from '../PhotoViewer.astro';
import SectionHero from '../SectionHero.astro';
import { t, type Locale, type Route } from '../../i18n';
import { CARD_FOCUS, COVERS, HEADERS, type GallerySlug } from '../../data/site';
import { CARD_ASPECT, HERO_ASPECT } from '../../utils/focus';
import { groupsIn, photoAt, photosIn } from '../../utils/photos';

interface Props {
  locale: Locale;
  gallery: GallerySlug;
}

const { locale, gallery } = Astro.props;
const dict = t(locale);
const meta = dict.galleries[gallery];
const photos = photosIn(gallery);

// Beyond F1 показывается группами по сериям, остальные разделы — одной лентой:
// там серия одна и та же, называть её нечем и незачем (см. groupsIn).
const groups = groupsIn(gallery);

// Шапка раздела — тот же кадр, что стоит на карточке раздела на главной и
// уходит в превью ссылки (COVERS). Меняется по-прежнему в одном месте:
// src/data/site.ts. Исключение — разделы из HEADERS: там кадр карточки не
// выдержал показа во всю ширину, и у шапки свой (см. комментарий у HEADERS).
const header = HEADERS[gallery];
const cover = photoAt(header?.photo ?? '') ?? photoAt(COVERS[gallery] ?? '');

// Видимая часть кадра — та же, что на карточке раздела на главной: сдвиг задан
// один раз (CARD_FOCUS в src/data/site.ts) и пересчитывается с прямоугольника
// карточки на полосу шапки (src/utils/focus.ts). Сюжет стоит в обоих местах
// одинаково, и шапка читается как продолжение карточки, с которой сюда пришли.
// У своего кадра шапки пересчитывать не от чего — сдвиг там задан для самой
// полосы, поэтому и рамка-источник у него другая.
const focus = header ? header.focus : CARD_FOCUS[gallery];
const focusIn = header ? HERO_ASPECT : CARD_ASPECT;
---

<Base locale={locale} route={gallery as Route}>
  {
    cover ? (
      <SectionHero
        image={cover}
        focus={focus}
        focusIn={focusIn}
        title={meta.title}
        description={meta.description}
      />
    ) : (
      <div class="wrap page-head">
        <h1>{meta.title}</h1>
        <p>{meta.description}</p>
      </div>
    )
  }

  {
    photos.length === 0 ? (
      <p class="wrap empty">{dict.gallery.empty}</p>
    ) : groups.length > 0 ? (
      <div class="wrap section">
        {groups.map((group, index) => (
          <section class:list={['series', index > 0 && 'series--next']}>
            {group.title && <h2 class="series__title">{group.title}</h2>}
            {/*
              Лента у каждой серии своя, и сама по себе она не знает, что она
              не первая на странице: без этих двух слов каждая берёт свои два
              кадра вперёд и вешает своему первому кадру высокий приоритет —
              в Beyond выходило 7 кадров вперёд вместо 3 и высокий приоритет
              у четверых сразу, то есть ни у кого (F1_P73). Ведущая на странице
              одна: шапка раздела и первая серия под ней.
            */}
            <PhotoGrid
              photos={group.photos}
              leading={index === 0}
              eagerCount={index === 0 ? 2 : 0}
            />
          </section>
        ))}
      </div>
    ) : (
      <div class="wrap section">
        <PhotoGrid photos={photos} />
      </div>
    )
  }

  {/*
    Просмотрщик один на страницу, а не на ленту: в Beyond лент три, по числу
    серий, и листаться раздел должен подряд, а не по серии (F1_P77).
  */}
  {photos.length > 0 && <PhotoViewer locale={locale} />}
</Base>
