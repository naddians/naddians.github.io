---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PhotoGrid from '../PhotoGrid.astro';
import { t, type Locale, type Route } from '../../i18n';
import { COVERS, type GallerySlug } from '../../data/site';
import { photoAt, photosIn } from '../../utils/photos';

interface Props {
  locale: Locale;
  gallery: GallerySlug;
}

const { locale, gallery } = Astro.props;
const dict = t(locale);
const meta = dict.galleries[gallery];
const photos = photosIn(gallery);

// Шапка раздела — тот же кадр, что стоит на карточке раздела на главной и
// уходит в превью ссылки (COVERS). Меняется по-прежнему в одном месте:
// src/data/site.ts.
const cover = photoAt(COVERS[gallery] ?? '');
---

<Base locale={locale} route={gallery as Route}>
  {
    cover ? (
      <section class="hero hero--section">
        <Picture
          src={cover}
          alt=""
          formats={['avif', 'webp']}
          widths={[640, 1024, 1600]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          pictureAttributes={{ class: 'hero__placeholder' }}
          class="hero__image hero__image--section"
        />
        <div class="hero__scrim" />
        <div class="wrap hero__inner">
          <h1 class="hero__title hero__title--section">{meta.title}</h1>
          <p class="hero__slogan">{meta.description}</p>
        </div>
      </section>
    ) : (
      <div class="wrap page-head">
        <h1>{meta.title}</h1>
        <p>{meta.description}</p>
      </div>
    )
  }

  {
    photos.length === 0 ? (
      <p class="wrap empty">{dict.gallery.empty}</p>
    ) : (
      <div class="wrap section">
        <PhotoGrid photos={photos} />
      </div>
    )
  }
</Base>
