---
import { Picture } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Base from '../../layouts/Base.astro';
import PhotoGrid from '../PhotoGrid.astro';
import ContactButtons from '../ContactButtons.astro';
import { t, type Locale, type Route } from '../../i18n';
import { FEATURED, FEATURED_PER_GALLERY, GALLERIES } from '../../data/site';
import { featuredPhotos, photoAt } from '../../utils/photos';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);

// Герой-кадр: src/photos/hero.jpg. Пока файла нет — заглушка, а если нет и её,
// то просто тёмная подложка.
const hero =
  photoAt('hero.jpg') ??
  photoAt('hero.jpeg') ??
  photoAt('hero.png') ??
  photoAt('hero_demo.jpg');

// Витрина: первые кадры каждой галереи вперемешку (ТЗ §3, правка 1.2).
const featured = featuredPhotos(FEATURED, FEATURED_PER_GALLERY);
---

<Base locale={locale} route={''}>
  <section class:list={['hero', !hero && 'hero--empty']}>
    {
      hero ? (
        <Picture
          src={hero}
          alt=""
          formats={['avif', 'webp']}
          widths={[640, 1024, 1600]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          pictureAttributes={{ class: 'hero__placeholder' }}
          class="hero__image"
        />
      ) : (
        <div class="hero__placeholder" />
      )
    }
    {hero && <div class="hero__scrim" />}
    <div class="wrap hero__inner">
      <h1 class="hero__title">{dict.name}</h1>
      <p class="hero__slogan">{dict.slogan}</p>
      <p class="hero__tagline">{dict.tagline}</p>
    </div>
  </section>

  <div class="wrap contact-bar">
    <ContactButtons locale={locale} />
  </div>

  {
    featured.length > 0 && (
      <section class="wrap section">
        <h2 class="section__title">{dict.home.selectedTitle}</h2>
        {/* Витрина уходит за первый экран: грузить её вперёд героя незачем. */}
        <PhotoGrid photos={featured} eagerCount={hero ? 0 : 2} leading={!hero} />
      </section>
    )
  }

  <section class="wrap section section--top-line">
    <h2 class="section__title">{dict.home.galleriesTitle}</h2>
    <div class="cards">
      {
        GALLERIES.map((slug) => (
          <a class="card" href={getRelativeLocaleUrl(locale, slug as Route)}>
            <h3 class="card__title">{dict.galleries[slug].title}</h3>
            <p class="card__desc">{dict.galleries[slug].description}</p>
          </a>
        ))
      }
    </div>
  </section>
</Base>
