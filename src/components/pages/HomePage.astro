---
import { Picture, getImage } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Base from '../../layouts/Base.astro';
import { t, type Locale, type Route } from '../../i18n';
import { AUTHOR, BEYOND_SERIES, CARD_FOCUS, COVERS, GALLERIES } from '../../data/site';
import { groupsIn, photoAt, photosIn } from '../../utils/photos';
import { licenseLinks } from '../../utils/license';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);

// Герой-кадр: src/photos/hero.jpg. Пока файла нет — заглушка, а если нет и её,
// то просто тёмная подложка.
const hero =
  photoAt('hero.jpg') ??
  photoAt('hero.jpeg') ??
  photoAt('hero.png') ??
  photoAt('hero_demo.jpg');

// Кадр на всю ширину окна: на широком мониторе нужны варианты крупнее 1600px,
// иначе браузер растягивает маленький файл и кадр мылит. Верхняя ступенька —
// ширина самого файла (COVER_WIDTH в scripts/photos.mjs).
const HERO_LADDER = [640, 1024, 1600, 2200, 2800];
const heroWidths = hero ? [...HERO_LADDER.filter((w) => w < hero.width), hero.width] : [];

/**
 * Разделы на главной — двумя полками (F1_P97, выбор заказчицы из макетов
 * 2026-10-28): «Formula 1» — три раздела про то, что в кадре, и «Beyond F1» —
 * по плитке на каждую серию, а не одна карточка на весь раздел. Одна карточка
 * стояла последней: на телефоне до неё листали три экрана, и что на сайте есть
 * не только Формула 1, оставалось незамеченным.
 *
 * Пустой раздел и серия без кадров плитки не получают — по той же причине, что
 * и строки в меню (см. Header.astro): наружу они выходят вместе с кадрами.
 * Плитка серии ведёт на её якорь на странице Beyond (/beyond/#t4, F1_P78).
 */
const f1 = GALLERIES.filter((slug) => slug !== 'beyond' && photosIn(slug).length > 0).map((slug) => ({
  slug,
  // Обложка та же, что уходит в превью ссылки (COVERS): раздел выглядит
  // одинаково и на главной, и в мессенджере, а менять её по-прежнему
  // в одном месте — src/data/site.ts.
  cover: photoAt(COVERS[slug] ?? ''),
  // Видимая часть кадра — по умолчанию середина. Разделам, у которых сюжет
  // упирается в подпись, кадр сдвигается (CARD_FOCUS в src/data/site.ts).
  focus: CARD_FOCUS[slug],
}));

const series = groupsIn('beyond')
  .filter((group) => group.slug)
  .map((group) => {
    const item: { cover?: string; focus?: string } =
      BEYOND_SERIES.find((s) => s.slug === group.slug) ?? {};
    return {
      slug: group.slug,
      title: group.title,
      cover: photoAt(item.cover ?? '') ?? group.photos[0].image,
      focus: item.focus,
    };
  })
  // На главной серии идут от конца BEYOND_SERIES к началу (F1_P99, просьба
  // заказчицы 2026-10-28); на самой странице Beyond порядок прежний.
  .reverse();

/**
 * Авторство кадров главной (F1_P25) — тем же способом, что в PhotoGrid.astro
 * и SectionHero.astro: в самих файлах его нет, Astro срезает метаданные при
 * пересборке размеров, поэтому автор указан разметкой (см. AUTHOR в site.ts).
 * Кадры здесь — герой и обложки разделов; портрет со страницы «Обо мне» сюда
 * не попадает намеренно: на нём заказчица, и снимала его не она.
 *
 * Условия использования (`license`, `acquireLicensePage`) — те же, что у кадров
 * ленты и шапок разделов (F1_P60, src/utils/license.ts).
 */
const homePhotos = [
  ...(hero ? [{ image: hero, widths: heroWidths, lead: true }] : []),
  // Те же кадры, что на плитках ниже: у раздела без кадров плитки на странице
  // нет, и заявлять её кадр в разметке нечего.
  ...[...f1, ...series]
    .map(({ cover }) => cover)
    .filter((cover) => cover !== undefined)
    .map((cover) => ({
      image: cover,
      widths: [800, 1600, 2400].filter((w) => w <= cover.width),
      lead: false,
    })),
];

const rights = licenseLinks(locale);

const imageLd = {
  '@context': 'https://schema.org',
  '@graph': await Promise.all(
    homePhotos.map(async ({ image, widths, lead }) => {
      const rendered = await getImage({
        src: image,
        width: widths[widths.length - 1],
        format: 'jpg',
      });
      return {
        '@type': 'ImageObject',
        contentUrl: new URL(rendered.src, Astro.site).href,
        ...(lead ? { representativeOfPage: true } : {}),
        creator: { '@type': 'Person', name: AUTHOR.name },
        creditText: AUTHOR.credit,
        copyrightNotice: AUTHOR.copyright,
        ...rights,
      };
    }),
  ),
};
---

<script type="application/ld+json" set:html={JSON.stringify(imageLd)} is:inline />

<Base locale={locale} route={''}>
  <section class:list={['hero', !hero && 'hero--empty']}>
    {
      hero ? (
        <Picture
          src={hero}
          alt=""
          formats={['avif', 'webp']}
          widths={heroWidths}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          pictureAttributes={{ class: 'hero__placeholder' }}
          class="hero__image"
        />
      ) : (
        <div class="hero__placeholder" />
      )
    }
    {hero && <div class="hero__scrim" />}
    <div class="wrap hero__inner">
      <h1 class="hero__title">{dict.name}</h1>
      <p class="hero__slogan">{dict.slogan}</p>
      <p class="hero__tagline">{dict.tagline}</p>

      {/* Тизер «Обо мне» в самом герое (F1_P64, решение заказчицы 2026-08-21).
          Полоса контактов, стоявшая под героем (F1_P38), с главной убрана: с
          F1_P40 контакты есть в шапке, и полоса повторяла её пункт. Освободилось
          место, но заодно просела заметность «Обо мне» — оно ушло в подвал.
          Фраза стоит последней строкой блока с именем — на любой ширине, и на
          телефоне, и на десктопе. Вторым столбцом справа она была только до
          F1_P69: на широком экране столбец висел поверх кадра сам по себе,
          далеко от имени. Обёртка .hero__name была нужна только тому столбцу
          и вместе с ним убрана.

          Фраза — из «Обо мне» дословно, не пересказ: это то, что заказчица
          говорит о себе, а не рекламная строка про неё.

          Строки под кнопками «Read first…» (F1_P63) здесь больше нет — она
          жила при кнопках и ушла вместе с ними; на «Обо мне» она осталась. */}
      <p class="hero__about">
        {dict.home.aboutTeaser}{' '}
        {/* Ссылка внутри фразы, а не отдельной строкой (решение заказчицы
            2026-08-21) — тем же приёмом, что «Write to me» в подвале: отдельной
            строкой она читается как подпись, а не как продолжение мысли. Точка
            стоит в разметке, чтобы не попасть под подчёркивание, а обёртка
            держит её на одной строке со ссылкой. */}
        <span class="hero__about-wrap">
          <a class="hero__about-link contact-link" href={getRelativeLocaleUrl(locale, 'about')}
            >{dict.home.aboutLink}</a
          >.
        </span>
      </p>
    </div>
  </section>

  {/* Линии сверху у блока нет: полосы контактов между ним и героем больше нет,
      и линию рисует нижняя граница самого героя — иначе на стыке вышли бы две
      подряд. */}
  <section class="wrap wrap--wide section">
    {f1.length > 0 && (
      <>
        <h2 class="section__title">{dict.home.f1Title}</h2>
        <div class="cards cards--f1">
          {f1.map(({ slug, cover, focus }, index) => (
            <a class="card" href={getRelativeLocaleUrl(locale, slug as Route)}>
              {cover && (
                <Picture
                  src={cover}
                  alt=""
                  formats={['avif', 'webp']}
                  widths={[800, 1600, 2400].filter((w) => w <= cover.width)}
                  sizes={index === 0 ? '(min-width: 700px) 33vw, 100vw' : '(min-width: 700px) 33vw, 50vw'}
                  loading="lazy"
                  decoding="async"
                  pictureAttributes={{ class: 'card__media' }}
                  class="card__image"
                  style={focus ? `object-position: ${focus}` : undefined}
                />
              )}
              <div class="card__scrim" />
              <h3 class="card__title">{dict.galleries[slug].title}</h3>
              {/* На телефоне пояснения нет: плитки там вдвое у́же прежних
                  карточек, и под названием места для него не остаётся. На
                  компьютере — короткое, полное в треть ширины не входит. */}
              <p class="card__desc">{dict.galleries[slug].short}</p>
            </a>
          ))}
        </div>
      </>
    )}

    {series.length > 0 && (
      <>
        <h2 class="section__title section__title--next">{dict.nav.beyond}</h2>
        <div class="cards cards--series">
          {series.map(({ slug, title, cover, focus }) => (
            <a class="card card--series" href={`${getRelativeLocaleUrl(locale, 'beyond')}#${slug}`}>
              <Picture
                src={cover}
                alt=""
                formats={['avif', 'webp']}
                widths={[400, 800, 1600].filter((w) => w <= cover.width)}
                sizes="(min-width: 700px) 33vw, 50vw"
                loading="lazy"
                decoding="async"
                pictureAttributes={{ class: 'card__media' }}
                class="card__image"
                style={focus ? `object-position: ${focus}` : undefined}
              />
              <div class="card__scrim" />
              <h3 class="card__title">{title}</h3>
            </a>
          ))}
        </div>
      </>
    )}
  </section>
</Base>
