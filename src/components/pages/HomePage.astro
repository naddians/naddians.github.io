---
import { Picture, getImage } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Base from '../../layouts/Base.astro';
import ContactButtons from '../ContactButtons.astro';
import { t, type Locale, type Route } from '../../i18n';
import { AUTHOR, CARD_FOCUS, COVERS, GALLERIES } from '../../data/site';
import { photoAt, photosIn } from '../../utils/photos';
import { licenseLinks } from '../../utils/license';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);

// Герой-кадр: src/photos/hero.jpg. Пока файла нет — заглушка, а если нет и её,
// то просто тёмная подложка.
const hero =
  photoAt('hero.jpg') ??
  photoAt('hero.jpeg') ??
  photoAt('hero.png') ??
  photoAt('hero_demo.jpg');

// Кадр на всю ширину окна: на широком мониторе нужны варианты крупнее 1600px,
// иначе браузер растягивает маленький файл и кадр мылит. Верхняя ступенька —
// ширина самого файла (COVER_WIDTH в scripts/photos.mjs).
const HERO_LADDER = [640, 1024, 1600, 2200, 2800];
const heroWidths = hero ? [...HERO_LADDER.filter((w) => w < hero.width), hero.width] : [];

/**
 * Авторство кадров главной (F1_P25) — тем же способом, что в PhotoGrid.astro
 * и SectionHero.astro: в самих файлах его нет, Astro срезает метаданные при
 * пересборке размеров, поэтому автор указан разметкой (см. AUTHOR в site.ts).
 * Кадры здесь — герой и обложки разделов; портрет со страницы «Обо мне» сюда
 * не попадает намеренно: на нём заказчица, и снимала его не она.
 *
 * Условия использования (`license`, `acquireLicensePage`) — те же, что у кадров
 * ленты и шапок разделов (F1_P60, src/utils/license.ts).
 */
const homePhotos = [
  ...(hero ? [{ image: hero, widths: heroWidths, lead: true }] : []),
  // Тот же отбор, что у карточек ниже: у раздела без кадров карточки на странице
  // нет, и заявлять её кадр в разметке нечего.
  ...GALLERIES.filter((slug) => photosIn(slug).length > 0)
    .map((slug) => photoAt(COVERS[slug] ?? ''))
    .filter((cover) => cover !== undefined)
    .map((cover) => ({
      image: cover,
      widths: [800, 1600, 2400].filter((w) => w <= cover.width),
      lead: false,
    })),
];

const rights = licenseLinks(locale);

const imageLd = {
  '@context': 'https://schema.org',
  '@graph': await Promise.all(
    homePhotos.map(async ({ image, widths, lead }) => {
      const rendered = await getImage({
        src: image,
        width: widths[widths.length - 1],
        format: 'jpg',
      });
      return {
        '@type': 'ImageObject',
        contentUrl: new URL(rendered.src, Astro.site).href,
        ...(lead ? { representativeOfPage: true } : {}),
        creator: { '@type': 'Person', name: AUTHOR.name },
        creditText: AUTHOR.credit,
        copyrightNotice: AUTHOR.copyright,
        ...rights,
      };
    }),
  ),
};
---

<script type="application/ld+json" set:html={JSON.stringify(imageLd)} is:inline />

<Base locale={locale} route={''}>
  <section class:list={['hero', !hero && 'hero--empty']}>
    {
      hero ? (
        <Picture
          src={hero}
          alt=""
          formats={['avif', 'webp']}
          widths={heroWidths}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          pictureAttributes={{ class: 'hero__placeholder' }}
          class="hero__image"
        />
      ) : (
        <div class="hero__placeholder" />
      )
    }
    {hero && <div class="hero__scrim" />}
    <div class="wrap hero__inner">
      <h1 class="hero__title">{dict.name}</h1>
      <p class="hero__slogan">{dict.slogan}</p>
      <p class="hero__tagline">{dict.tagline}</p>
    </div>
  </section>

  {/* Полоса контактов под именем: три кнопки в одну строку (F1_P38). До первой
      фотографии сайт не должен просить написать в полный голос — строка одна
      и тихая, а сами кнопки остаются на месте. */}
  <div class="wrap contact-bar">
    {/* Заголовок тот же, что у разделов ниже, вместе с отступом до содержимого:
        от «Contacts» до кнопок столько же, сколько от «Galleries» до первого
        кадра — иначе на одной странице два разных шага. */}
    <h2 class="section__title">{dict.home.contactsTitle}</h2>
    <ContactButtons locale={locale} row />
  </div>

  <section class="wrap wrap--wide section section--top-line">
    <h2 class="section__title">{dict.home.galleriesTitle}</h2>
    <div class="cards">
      {
        // Пустой раздел карточки не получает — по той же причине, что и строки
        // в меню (см. Header.astro): наружу он выходит вместе с кадрами.
        GALLERIES.filter((slug) => photosIn(slug).length > 0).map((slug) => {
          // Обложка та же, что уходит в превью ссылки (COVERS): раздел выглядит
          // одинаково и на главной, и в мессенджере, а менять её по-прежнему
          // в одном месте — src/data/site.ts.
          const cover = photoAt(COVERS[slug] ?? '');
          // Видимая часть кадра в карточке — по умолчанию середина. Разделам,
          // у которых сюжет упирается в подпись, кадр сдвигается (CARD_FOCUS
          // в src/data/site.ts). Сдвиг свой, не тот, что у шапки раздела:
          // там полоса во всю ширину, здесь прямоугольник 5×4.
          const focus = CARD_FOCUS[slug];

          return (
            <a class="card" href={getRelativeLocaleUrl(locale, slug as Route)}>
              {cover && (
                <Picture
                  src={cover}
                  alt=""
                  formats={['avif', 'webp']}
                  widths={[800, 1600, 2400].filter((w) => w <= cover.width)}
                  sizes="(min-width: 700px) 50vw, 100vw"
                  loading="lazy"
                  decoding="async"
                  pictureAttributes={{ class: 'card__media' }}
                  class="card__image"
                  style={focus ? `object-position: ${focus}` : undefined}
                />
              )}
              <div class="card__scrim" />
              <h3 class="card__title">{dict.galleries[slug].title}</h3>
              {/* Два варианта пояснения: на узкой карточке полное разворачивалось
                  в две-три строки и загораживало кадр. Какое показать, решает
                  ширина самой карточки, а не окна (global.css, @container). */}
              <p class="card__desc">
                <span class="card__desc-short">{dict.galleries[slug].short}</span>
                <span class="card__desc-full">{dict.galleries[slug].description}</span>
              </p>
            </a>
          );
        })
      }
    </div>
  </section>
</Base>
