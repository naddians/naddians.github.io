---
import Base from '../../layouts/Base.astro';
import ContactButtons from '../ContactButtons.astro';
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);

// Страница-текст, без кадра в шапке: сюда приходят не смотреть, а прочитать
// четыре пункта. Кадр отсюда же и не нужен — из Картинок Google человек уже
// пришёл от конкретной фотографии.
//
// Это же адрес, на который в разметке каждого кадра указывает поле `license`
// (src/utils/license.ts, F1_P60): страница обязана быть у обоих языков,
// поэтому маршрут заведён в ROUTES и живёт в обеих папках pages/.
const items = dict.license.items as ReadonlyArray<{ label: string; text: string }>;
---

<Base locale={locale} route={'license'}>
  <div class="wrap page-head">
    <h1>{dict.license.title}</h1>
    <p>{dict.license.lead}</p>
  </div>

  <section class="wrap license">
    <ol class="license__list">
      {
        items.map((item) => (
          <li class="license__item">
            <h2 class="license__label">{item.label}</h2>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ol>

    {/* Адреса стоят прямо здесь, кнопками, а не ссылкой на контакты (F1_P62):
        сюда приходят из Картинок Google спросить про один кадр, и это не заказ
        съёмки — гонять человека на отдельную страницу ради трёх адресов незачем.
        Вариант `row` — тот же, что в полосе под именем на главной: на телефоне
        три кнопки укладываются в одну строку и не занимают собой экран. */}
    <div class="license__how">
      <h2 class="block__title">{dict.license.howTitle}</h2>
      <p>{dict.license.how}</p>
      <ContactButtons locale={locale} row />
    </div>
  </section>
</Base>
