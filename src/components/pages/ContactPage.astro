---
import Base from '../../layouts/Base.astro';
import SectionHero from '../SectionHero.astro';
import { t, type Locale } from '../../i18n';
import { CONTACTS, HEADERS } from '../../data/site';
import { HERO_ASPECT } from '../../utils/focus';
import { mailtoLink } from '../../utils/obfuscate';
import { photoAt } from '../../utils/photos';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);

// Шапка страницы устроена как у галерей: полоса во всю ширину, название поверх
// кадра (F1_P39). До этого контакты были единственной страницей сайта без единой
// фотографии и выглядели чужими. Кадр — HEADERS.contact в src/data/site.ts.
const header = HEADERS.contact;
const cover = photoAt(header?.photo ?? '');
---

<Base locale={locale} route={'contact'}>
  {
    cover ? (
      <SectionHero
        image={cover}
        focus={header?.focus}
        focusIn={HERO_ASPECT}
        title={dict.contact.title}
        description={dict.contact.intro}
      />
    ) : (
      <div class="wrap page-head">
        <h1>{dict.contact.title}</h1>
        <p>{dict.contact.intro}</p>
      </div>
    )
  }

  <dl class="wrap contacts">
    <div>
      <dt>Email</dt>
      <dd><span set:html={mailtoLink(CONTACTS.email)} /></dd>
    </div>
    <div>
      <dt>Instagram</dt>
      <dd>
        <a
          class="contact-link"
          href={`https://instagram.com/${CONTACTS.instagram}`}
          rel="me noopener"
        >
          @{CONTACTS.instagram}
        </a>
      </dd>
    </div>
  </dl>

  {/* Условия работы (F1_P39). Отдельной страницы «услуги» нет — решение
      заказчицы, поэтому текст живёт здесь, под адресами: кто пришёл за адресом,
      получает его сразу, а кто собирается писать про съёмку — читает дальше.
      Ссылки сюда с других страниц ставились после того, как страницу довели
      (решение заказчицы 2026-08-15): с F1_P63 на раздел ведут строки под
      кнопками контактов на главной и в «Обо мне» — за тем id, что оставлен
      здесь заранее. */}
  <section class="wrap terms" id="working-together">
    <h2 class="section__title">{dict.contact.terms.title}</h2>
    <p class="terms__lead">{dict.contact.terms.lead}</p>

    {/* Расхлопы, решение заказчицы 2026-08-15: шесть абзацев подряд читались
        стеной текста, особенно на телефоне. Свёрнутые пункты дают список
        названий на один экран — человек открывает то, что ему нужно.
        Нативный <details>, без JS: работает везде, открывается по нажатию
        и по клавише, а текст внутри остаётся в разметке — Google его видит
        и поиск по странице находит. */}
    <div class="terms__list">
      {
        /* Пункт внутри — либо перечень (`list`), либо абзац (`text`): почти всё,
           что мы записали, на самом деле список — что снимаю, что придёт
           в файлах, что прислать в письме. Прозой остаётся только то, что
           списком не разбивается. `note` — короткий хвост под перечнем
           («Stills only, no video»), он про весь пункт целиком, а не про
           последнюю строку, поэтому стоит отдельно. */
        (
          dict.contact.terms.items as ReadonlyArray<{
            label: string;
            text?: string;
            list?: readonly string[];
            note?: string;
          }>
        ).map((item) => (
          <details class="terms__item">
            <summary>{item.label}</summary>
            {item.text && <p>{item.text}</p>}
            {item.list && (
              <ul class="terms__points">
                {item.list.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            )}
            {item.note && <p class="terms__small">{item.note}</p>}
          </details>
        ))
      }
    </div>

    <p class="terms__note">{dict.contact.terms.note}</p>
  </section>
</Base>
