---
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
---

{/* Адреса из блока убраны (F1_P39, решение заказчицы 2026-08-15): те же почта,
    Telegram и Instagram стояли здесь, в подвале, на главной и в «Обо мне» —
    четыре раза на одной странице. Остались две строки, и блок стал вдвое ниже.
    Чем он станет дальше — решается в F1_P41; пока действие человек берёт
    из подвала, который идёт сразу под ним. */}
<section class="cta">
  <div class="wrap cta__inner">
    <h2 class="cta__title">{dict.cta.title}</h2>
    <p class="cta__text">{dict.cta.text}</p>
  </div>
</section>
