---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
---

{/* Адреса из блока убраны (F1_P39, решение заказчицы 2026-08-15): те же почта,
    Telegram и Instagram стояли здесь, в подвале, на главной и в «Обо мне» —
    четыре раза на одной странице. Остались две строки, и блок стал вдвое ниже.
    Одно действие вместо трёх адресов дала F1_P41 — ссылка на страницу
    контактов: там и условия работы, и адреса, в одном месте, и четвёртого
    повтора тех же трёх контактов на странице не появляется. */}
<section class="cta">
  <div class="wrap cta__inner">
    <h2 class="cta__title">{dict.cta.title}</h2>

    {/* Ссылка стоит в той же строке, что и текст (решение заказчицы
        2026-08-15): отдельной строкой под абзацем она читалась как ещё
        одна подпись, а не как продолжение фразы. */}
    <p class="cta__text">
      {dict.cta.text}{' '}
      {/* Точка стоит в разметке, а не в переводе: внутри ссылки она попала бы
          под подчёркивание. Обёртка держит её на одной строке со ссылкой,
          чтобы точка не съехала на следующую строку одна. */}
      <span class="cta__link-wrap">
        <a class="cta__link contact-link" href={getRelativeLocaleUrl(locale, 'contact')}
          >{dict.cta.link}</a
        >.
      </span>
    </p>
  </div>
</section>
