---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer__inner">
    <p style="margin:0">© {year} {dict.name}. {dict.footer.rights}</p>

    {/* Одна ссылка вместо трёх адресов (F1_P39, решение заказчицы 2026-08-15).
        Раньше подвал повторял почту, Telegram и Instagram на каждой странице —
        те же три адреса, что стоят кнопками на главной и в «Обо мне», плюс
        ссылка «Contact» рядом с ними. Теперь подвал ведёт на страницу
        контактов, а адреса и условия работы человек видит там, в одном месте
        и вместе.

        Рядом — условия использования кадров (F1_P60). В меню наверху их нет
        намеренно: страница нужна не тому, кто пришёл смотреть галереи, а тому,
        кто уже выбрал кадр и думает его взять. Подвал — обычное место для
        такой ссылки, и он есть на каждой странице. */}
    <nav class="footer__links" aria-label={dict.contact.title}>
      <a class="contact-link" href={getRelativeLocaleUrl(locale, 'contact')}>{dict.nav.contact}</a>
      <a class="contact-link" href={getRelativeLocaleUrl(locale, 'license')}>{dict.nav.license}</a>
    </nav>
  </div>
</footer>
