---
import { Picture, getImage } from 'astro:assets';
import type { Photo } from '../utils/photos';
import { AUTHOR } from '../data/site';
import { licenseLinksFor } from '../utils/license';

interface Props {
  photos: Photo[];
  /** Сколько первых кадров грузить сразу — остальные лениво. */
  eagerCount?: number;
  /** Первый кадр — главный на экране (нет героя выше). Тогда ему высокий приоритет. */
  leading?: boolean;
}

const { photos, eagerCount = 2, leading = true } = Astro.props;

/** Зазор между кадрами. Держать в паре с --gap в global.css: по нему считаются ряды. */
const GAP = 8;

/**
 * Опорные ширины, под которые считаются разрезы, и желаемая высота ряда.
 * Ширина ленты — это окно минус поля (--pad), но не больше 1600 (--max):
 * на компьютере это 1504, на планшете около 880. Точная ширина окна значения
 * не имеет: разрезы от неё почти не зависят, а высоту ряда браузер подгоняет
 * сам — см. ниже.
 *
 * Желаемая высота — это выбранный масштаб кадра: 580 на компьютере значит
 * 2–3 кадра в ряду. Числа проверены на всех разделах: при них разрезы выходят
 * ровно те, что на утверждённых листах (2026-08-25). Планшетное 360 — то же
 * самое, пересчитанное на узкую ленту, чтобы кадр не менял величину при
 * повороте.
 */
const WIDE = { width: 1504, target: 580 };
const MID = { width: 880, target: 360 };

/**
 * Как галерея разложена (F1_P36). Кадры идут слева направо рядами; в ряду у
 * всех одна высота, и ряд заполняет ширину точно. Низ ряда поэтому ровный
 * всегда — той дыры под короткой колонкой, что чинилась в F1_P23, F1_P26,
 * F1_P31, F1_P45 и F1_P49, здесь не бывает по устройству.
 *
 * Здесь, при сборке, считается только одно: где лента режется на ряды.
 * Ширину внутри ряда подбирает браузер флексом — каждому кадру дано расти
 * пропорционально его пропорции, поэтому в ряду они выходят одной высоты, а
 * ряд заполняет ленту без остатка на любой ширине окна. Это ровно то, чего не
 * умели колонки: их высоту приходилось считать заранее, и разрез на две
 * колонки был обязан совпасть с разрезом на три (F1_P45). Ряды считаются
 * независимо, и никакой кадр от этого не попадает в разметку дважды: границы
 * рядов — пустые метки между кадрами, лишние гасятся `display: none`.
 *
 * Раскладку целиком браузеру всё же не отдаём. Свободный перенос флексом
 * набирает ряд жадно, и последний ряд остаётся неполным — под ним пустое
 * место, та же дыра, только внизу. Поэтому разрезы считаются по всей ленте
 * разом (planRows): лишние кадры расходятся по соседним рядам, а не копятся
 * в хвосте.
 */
function planRows(aspects: number[], { width, target }: { width: number; target: number }): number[] {
  const n = aspects.length;
  if (n === 0) return [0];

  // Высота ряда из кадров i..j-1, заполняющего ленту точно: ширины кадров
  // относятся как их пропорции, значит высота — это ширина, делённая на их сумму.
  const rowHeight = (i: number, j: number) => {
    let sum = 0;
    for (let k = i; k < j; k++) sum += aspects[k];
    return (width - GAP * (j - i - 1)) / sum;
  };

  // Цена ряда — насколько его высота отличается от желаемой; ищется набор
  // разрезов с наименьшей общей ценой. Ряд из одного вертикального кадра во всю
  // ленту был бы вдвое выше соседей и кричал бы громче остальных, поэтому за
  // высоту сверх полутора целей цена растёт отдельно — но остаётся конечной:
  // запрет здесь оставил бы короткую ленту вообще без раскладки.
  const cost = new Array(n + 1).fill(Infinity);
  const from = new Array(n + 1).fill(0);
  cost[0] = 0;

  const MAX_IN_ROW = 5;
  for (let j = 1; j <= n; j++) {
    for (let i = Math.max(0, j - MAX_IN_ROW); i < j; i++) {
      if (cost[i] === Infinity) continue;
      const h = rowHeight(i, j);
      const tall = Math.max(0, h - target * 1.5);
      const price = cost[i] + (h - target) ** 2 + tall ** 2 * 8;
      if (price < cost[j]) {
        cost[j] = price;
        from[j] = i;
      }
    }
  }

  const starts = [n];
  while (starts[0] > 0) starts.unshift(from[starts[0]]);
  return starts;
}

const ASPECTS = photos.map((photo) => photo.image.width / photo.image.height);

/** Доля ленты, которую кадр занимает в своём ряду: по ней считается `sizes`. */
function sharesFrom(starts: number[]): number[] {
  const shares = new Array(ASPECTS.length).fill(1);
  for (let r = 0; r < starts.length - 1; r++) {
    const [i, j] = [starts[r], starts[r + 1]];
    let sum = 0;
    for (let k = i; k < j; k++) sum += ASPECTS[k];
    for (let k = i; k < j; k++) shares[k] = ASPECTS[k] / sum;
  }
  return shares;
}

const wide = planRows(ASPECTS, WIDE);
const mid = planRows(ASPECTS, MID);
const cutWide = new Set(wide.slice(1, -1));
const cutMid = new Set(mid.slice(1, -1));
const shareWide = sharesFrom(wide);
const shareMid = sharesFrom(mid);

/**
 * Какие размеры файла готовить. Больше, чем кадр показывается на экране с
 * двойной плотностью, не нужно: эти варианты браузер бы качал зря, а сборка
 * зря считала. В колонках потолок был общий (треть ленты), в рядах он у каждого
 * кадра свой — кадр может занять и четверть ряда, и весь ряд целиком.
 */
const LADDER = [400, 800, 1200, 1600, 2000];

function widthsFor(width: number, onScreen: number): number[] {
  const max = Math.min(width, Math.ceil(onScreen * 2));
  return [...LADDER.filter((w) => w < max), max];
}

/** Ширина кадра на экране в самом большом случае — на компьютере. */
const onScreen = (index: number) => shareWide[index] * WIDE.width;

/**
 * Какой ширины кадр окажется на экране — браузеру это нужно знать до того, как
 * он выберет файл. Доля ряда известна с точностью до пикселя, ширина ленты — это
 * окно минус поля, поэтому 95vw с запасом на поля.
 */
const sizesFor = (index: number) =>
  `(min-width: 1024px) ${Math.round(shareWide[index] * 95)}vw, ` +
  `(min-width: 640px) ${Math.round(shareMid[index] * 95)}vw, 100vw`;

/**
 * Авторство кадров для робота (F1_P25). У каждой фотографии — своя запись
 * `ImageObject` с автором, кредитом и копирайтом: в самих файлах этого нет,
 * Astro срезает метаданные при пересборке размеров (см. AUTHOR в site.ts).
 *
 * `contentUrl` считается тем же `getImage`, что и запасной кадр внутри
 * `<Picture>`, с теми же шириной и форматом, — значит указывает на файл,
 * который на странице действительно есть, а не на ещё один, сгенерированный
 * ради разметки. Ширина — как в `widthsFor`: последняя ступенька лестницы.
 *
 * `license` и `acquireLicensePage` — условия использования и адрес, по которому
 * кадр запрашивают (F1_P60). Без первого Google не ставит в Картинках подпись
 * «Licensable»: было сказано, чей кадр, но не сказано, можно ли его взять.
 *
 * `description` — тот же текст, что в `alt`. Пока описания не заполнены
 * (scripts/captions.json), это общее слово по разделу, и это честно: выдумывать
 * содержание кадра нельзя, а авторство от описания не зависит и работает уже.
 */
const rights = licenseLinksFor(Astro.url);

/**
 * Кадр для просмотрщика (F1_P77) — тот же файл, но во весь экран, а не долей
 * ряда. Отдельный размер здесь нужен потому, что лестница ленты обрезана по
 * месту кадра в ряду (widthsFor): кадру в четверть ряда там дальше 1000px
 * ступенек нет, а в просмотрщике он занимает окно целиком.
 *
 * Дописать этот размер в ту же лестницу было нельзя: `sizes` говорит браузеру
 * ширину кадра в ленте, и на экране с двойной плотностью он выбрал бы самый
 * большой файл из списка — лента стала бы тяжелее у всех, включая тех, кто
 * просмотрщик не открыл.
 *
 * Потолок 2000 — тот же, что у ленты (LADDER): длинная сторона у 54 кадров
 * из 60 и так меньше 1700px, выше потолка поднимаются четыре.
 *
 * Форматов два, а не три: avif в просмотрщике не считается. Кадр здесь
 * качается по одному и только когда его открыли, поэтому лишние 30% веса
 * стоят дешевле, чем 60 лишних avif при каждой сборке.
 */
const VIEWER_MAX = 2000;

const viewer = await Promise.all(
  photos.map(async (photo) => {
    const width = Math.min(photo.image.width, VIEWER_MAX);
    const [webp, jpg] = await Promise.all([
      getImage({ src: photo.image, width, format: 'webp' }),
      getImage({ src: photo.image, width, format: 'jpg' }),
    ]);
    return { webp: webp.src, jpg: jpg.src, width, height: Math.round(width / (photo.image.width / photo.image.height)) };
  }),
);

const imageLd = {
  '@context': 'https://schema.org',
  '@graph': await Promise.all(
    photos.map(async (photo, index) => {
      const widths = widthsFor(photo.image.width, onScreen(index));
      const rendered = await getImage({
        src: photo.image,
        width: widths[widths.length - 1],
        format: 'jpg',
      });
      return {
        '@type': 'ImageObject',
        contentUrl: new URL(rendered.src, Astro.site).href,
        description: photo.alt,
        creator: { '@type': 'Person', name: AUTHOR.name },
        creditText: AUTHOR.credit,
        copyrightNotice: AUTHOR.copyright,
        ...rights,
      };
    }),
  ),
};
---

<script type="application/ld+json" set:html={JSON.stringify(imageLd)} is:inline />

<div class="grid">
  {
    photos.map((photo, index) => (
      <>
        {(cutWide.has(index) || cutMid.has(index)) && (
          <span
            class:list={[
              'grid__break',
              cutWide.has(index) && 'grid__break--wide',
              cutMid.has(index) && 'grid__break--mid',
            ]}
            aria-hidden="true"
          />
        )}
        {/*
          Ссылка, а не кнопка: без JS она открывает сам файл кадра — страница
          остаётся целой, просто крупный кадр показывает браузер (F1_P77).
          С JS переход перехватывается и открывается просмотрщик.
        */}
        <a
          class="shot"
          style={`--a: ${ASPECTS[index].toFixed(4)}`}
          href={viewer[index].jpg}
          data-webp={viewer[index].webp}
          data-w={viewer[index].width}
          data-h={viewer[index].height}
        >
          <Picture
            src={photo.image}
            alt={photo.alt}
            formats={['avif', 'webp']}
            widths={widthsFor(photo.image.width, onScreen(index))}
            sizes={sizesFor(index)}
            loading={index < eagerCount ? 'eager' : 'lazy'}
            fetchpriority={leading && index === 0 ? 'high' : undefined}
            decoding="async"
          />
        </a>
      </>
    ))
  }
</div>
