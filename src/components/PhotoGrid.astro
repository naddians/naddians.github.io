---
import { Picture } from 'astro:assets';
import type { Photo } from '../utils/photos';

interface Props {
  photos: Photo[];
  /** Сколько первых кадров грузить сразу — остальные лениво. */
  eagerCount?: number;
  /** Первый кадр — главный на экране (нет героя выше). Тогда ему высокий приоритет. */
  leading?: boolean;
}

const { photos, eagerCount = 2, leading = true } = Astro.props;

/**
 * Кадр в сетке шире 1200px не показывается никогда: три колонки в контейнере
 * 1600px дают 528 CSS-пикселей, то есть 1056 на экране с двойной плотностью.
 * Варианты 1600 и 2000 браузер бы качал зря, а сборка их зря считала.
 */
const LADDER = [400, 800, 1200];

function widthsFor(width: number): number[] {
  const max = Math.min(width, LADDER[LADDER.length - 1]);
  return [...LADDER.filter((w) => w < max), max];
}

const SIZES = '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw';

/** Кадр вместе с его номером в ленте: номер решает, какие кадры грузятся сразу. */
type Numbered = { photo: Photo; index: number };

/**
 * Как разложить ленту по колонкам. Раскладку колонок браузеры считают сами и
 * считают по-разному: и какой кадр в какую колонку попадёт, и какой высоты
 * выйдет вся галерея. Safari на этом ошибался дважды — сначала складывал два
 * кадра в первую колонку и оставлял третью пустой (F1_P23), потом растягивал
 * галерею на всю длину ленты, и следующая группа уезжала вниз (F1_P26).
 * Поэтому колонки нарезаются здесь, при сборке, и лежат в разметке готовыми
 * блоками — браузеру остаётся поставить их в ряд.
 *
 * Колонок в окне то одна, то две, то три, а кадр в разметке должен лежать один
 * раз, иначе браузер скачает его дважды. Отсюда вложенность: лента режется
 * пополам, и одна из половин делится ещё раз — это и есть третья колонка.
 * В окне поуже лишний уровень распускается (`display: contents` в global.css),
 * и колонками становятся сами половины.
 *
 * Отсюда же и цена: разрез пополам обязан совпасть с одной из границ тройки,
 * а лучший разрез на две колонки редко попадает в границы лучшего разреза на
 * три. Приоритет у трёх — широкий экран главнее: три колонки берутся такими же,
 * какими их дал бы свободный разрез (самая длинная колонка — самая короткая из
 * возможных), с запасом в 5%. Запас нужен, чтобы было из чего выбирать: из
 * подходящих вариантов берётся тот, что ровнее ложится на две колонки, и на
 * длинных лентах это спрямляет их заметно — на On-Track разница 29% против 14%.
 * Кадров десятки, вариантов считанные сотни — перебор дешевле, чем угадывание.
 *
 * Высота кадра здесь — отношение сторон: ширина у колонок одинаковая, значит
 * пропорций достаточно, чтобы сравнить, какая колонка длиннее.
 */
function layoutColumns(items: Numbered[]): Numbered[][][] {
  // Кадров меньше, чем колонок: каждому своя, иначе последние останутся пустыми.
  if (items.length <= 2) return items.map((item) => [[item]]);

  const ratios = items.map(({ photo }) => photo.image.height / photo.image.width);
  const n = ratios.length;

  // Сумма высот первых i кадров — чтобы высоту любого куска брать вычитанием.
  const prefix = [0];
  for (const r of ratios) prefix.push(prefix[prefix.length - 1] + r);
  const height = (from: number, to: number) => prefix[to] - prefix[from];

  // Сначала — насколько короткой вообще может быть самая длинная из трёх колонок.
  let free3 = Infinity;
  for (let a = 1; a < n - 1; a++) {
    for (let b = a + 1; b < n; b++) {
      free3 = Math.min(free3, Math.max(height(0, a), height(a, b), height(b, n)));
    }
  }

  // Затем из вариантов, укладывающихся в эти 5%, берём самый ровный на двух
  // колонках. c — где лента режется пополам, d — где делится половина: если d
  // меньше c, делится первая половина, если больше — вторая.
  const limit = free3 * 1.05;
  let bestTwo = Infinity;
  let bestCut: [number, number] = [1, 2];

  for (let a = 1; a < n - 1; a++) {
    for (let b = a + 1; b < n; b++) {
      if (Math.max(height(0, a), height(a, b), height(b, n)) > limit) continue;

      // Тройка (a, b) годится; пополам её можно сложить по a или по b.
      for (const c of [a, b]) {
        const two = Math.max(height(0, c), height(c, n));
        if (two < bestTwo) {
          bestTwo = two;
          bestCut = [c, c === a ? b : a];
        }
      }
    }
  }

  const [c, d] = bestCut;
  return d < c
    ? [[items.slice(0, d), items.slice(d, c)], [items.slice(c)]]
    : [[items.slice(0, c)], [items.slice(c, d), items.slice(d)]];
}

const layout = layoutColumns(photos.map((photo, index) => ({ photo, index })));
---

<div class="grid">
  {
    layout.map((half) => (
      <div class="grid__half">
        {half.map((third) => (
          <div class="grid__third">
            {third.map(({ photo, index }) => (
              <Picture
                src={photo.image}
                alt={photo.alt}
                formats={['avif', 'webp']}
                widths={widthsFor(photo.image.width)}
                sizes={SIZES}
                loading={index < eagerCount ? 'eager' : 'lazy'}
                fetchpriority={leading && index === 0 ? 'high' : undefined}
                decoding="async"
              />
            ))}
          </div>
        ))}
      </div>
    ))
  }
</div>
