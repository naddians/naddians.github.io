---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { HTML_LANG, LOCALES, t } from '../i18n';
import '../styles/global.css';

// Своя разметка вместо общего макета: странице 404 не нужны canonical,
// hreflang и микроразметка — её не индексируют.
//
// Язык. Файл на весь сайт один: GitHub Pages отдаёт /404.html по любому
// несуществующему адресу, включая /sr/… и /de/…, — а при сборке неизвестно,
// куда человек пришёл, адрес виден только в браузере. Поэтому в страницу
// кладутся все версии сразу, а короткий скрипт в <head> оставляет ту, что
// совпадает с адресом (F1_P32). Английская стоит по умолчанию: без скрипта
// страница работает ровно так, как работала раньше.
const base = import.meta.env.BASE_URL;
const prefixedLocales = LOCALES.filter((locale) => locale !== 'en');
const prefixes = prefixedLocales.map((locale) => `${base}${locale}`);
const langs = prefixedLocales.map((locale) => HTML_LANG[locale]);
const titles = prefixedLocales.map((locale) => `${t(locale).notfound.title} — ${t(locale).name}`);

// Кадра на странице нет: надписи ложились на светлый асфальт, и контраст падал
// до 1,8 : 1 у «404» при норме 3 : 1 — затемнение рассчитано на нижнюю часть
// кадра, а текст стоял выше. Приглушённый кадр на фоне пробовали 2026-08-15 —
// решение заказчицы в тот же день: без кадра лучше. Новый подберём в F1_P11.
---

<!doctype html>
<html lang={HTML_LANG.en} data-l10n="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0b" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content="noindex" />
    <title>{t('en').notfound.title} — {t('en').name}</title>
    <link rel="icon" href={`${base}favicon-96.png`} type="image/png" sizes="96x96" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <script is:inline define:vars={{ prefixedLocales, prefixes, langs, titles }}>
      const i = prefixes.findIndex(
        (prefix) => location.pathname === prefix || location.pathname.startsWith(prefix + '/'),
      );
      if (i !== -1) {
        document.documentElement.dataset.l10n = prefixedLocales[i];
        document.documentElement.lang = langs[i];
        document.title = titles[i];
      }
    </script>
  </head>
  <body>
    {
      LOCALES.map((locale) => (
        <div class="l10n" data-locale={locale}>
          <Header locale={locale} route={''} />

          <main class="main">
            <section class="notfound">
              <div class="wrap">
                <p class="notfound__code">{t(locale).notfound.code}</p>
                <h1 class="notfound__title">{t(locale).notfound.title}</h1>
                <p class="notfound__text">{t(locale).notfound.text}</p>
                <a class="notfound__back" href={getRelativeLocaleUrl(locale, '')}>
                  {t(locale).notfound.back}
                </a>
              </div>
            </section>
          </main>

          <Footer locale={locale} />
        </div>
      ))
    }
  </body>
</html>
